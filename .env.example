# --- OpenAI (required) — https://platform.openai.com/api-keys ---
OPENAI_API_KEY=sk-...
# Realtime voice model for the interviewer: latency-first.
INTERVIEWER_MODEL=gpt-5.4-mini
# GPT-5-family: "none" disables reasoning for the lowest time-to-first-token
# (best for voice); raise to low/medium/high for harder tasks.
INTERVIEWER_REASONING_EFFORT=none
# Only applies to pre-GPT-5 models; GPT-5-family models reject it.
INTERVIEWER_TEMPERATURE=0.7

# --- LiveKit (required) — https://cloud.livekit.io > Settings > Keys ---
# Key/secret auth the Inference gateway (STT/TTS); LIVEKIT_URL is where the
# worker and the browser join interview rooms.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT (AssemblyAI via LiveKit Inference) ---
# Empty STT_LANGUAGE auto-detects the spoken language per utterance. If your
# language comes out garbled (and causes 3s end-of-turn pauses), pin it with
# an ISO code, e.g. STT_LANGUAGE=es.
STT_MODEL=assemblyai/universal-streaming-multilingual
STT_LANGUAGE=

# --- TTS (xAI "Eve x1" via LiveKit Inference) ---
# Multilingual with language auto-detection. Other providers work too
# (see https://docs.livekit.io/agents/models/tts), e.g. Cartesia Sonic 3 —
# faster to start speaking (~0.2s vs ~0.7s ttfb); TTS_VOICE is then a Cartesia
# voice UUID (https://play.cartesia.ai/voices):
#   TTS_MODEL=cartesia/sonic-3
#   TTS_VOICE=5c5ad5e7-1020-476b-8b91-fdcbe9cc313c  # Daniela (es-MX)
TTS_MODEL=xai/tts-1
TTS_VOICE=eve  # other xAI voices: ara, leo, rex

# --- Interview system ---
# Planner/evaluator run once per interview with no latency pressure:
# quality-first model + high reasoning effort.
PLANNER_MODEL=gpt-5.5
PLANNER_REASONING_EFFORT=high
EVALUATOR_MODEL=gpt-5.5
EVALUATOR_REASONING_EFFORT=high
# Embeddings for the resume RAG (1536 dims — matches the Qdrant collection).
EMBEDDING_MODEL=text-embedding-3-small

# Postgres + Qdrant from docker-compose.yml (non-default host ports — see
# the note there).
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5433/interview
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=resumes

# Hard time cap for the voice interview: wrap-up cue at T-2min, forced close
# at T. Milestones normally end it earlier.
INTERVIEW_MAX_MINUTES=15
# Soft cap on simultaneous interviews (cost protection): /token returns 429
# once this many are in progress.
MAX_CONCURRENT_INTERVIEWS=3
# End the interview if the conversation stays silent this long (no speech
# from either side), e.g. the candidate walked away with the tab open.
INTERVIEW_IDLE_MINUTES=3
# Explicit-dispatch agent name; must match the RoomAgentDispatch in the token.
LIVEKIT_AGENT_NAME=interviewer
# Where the worker reaches FastAPI to auto-trigger the evaluation.
APP_BASE_URL=http://localhost:8000
# PII retention: interviews (resume, transcript, evaluation) older than this
# are purged from Postgres and Qdrant by the server. 0 disables the purge.
RETENTION_DAYS=30

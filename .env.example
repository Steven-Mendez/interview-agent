# --- OpenAI (required) — https://platform.openai.com/api-keys ---
OPENAI_API_KEY=sk-...
# Quality-first interviewer; benchmark quality and audible latency together.
INTERVIEWER_MODEL=gpt-6-astra
# Astra / GPT-6.1 Sol support low and above, not none/minimal.
INTERVIEWER_REASONING_EFFORT=low
# Only applies to pre-GPT-5 models; GPT-5/6 models reject it.
INTERVIEWER_TEMPERATURE=0.7

# --- LiveKit (required) — https://cloud.livekit.io > Settings > Keys ---
# Key/secret auth the Inference gateway (STT/TTS); LIVEKIT_URL is where the
# worker and the browser join interview rooms.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Accounts ---
# `neon` (the default when AUTH_MODE is unset, i.e. production) verifies the
# Neon Auth JWT on every request against NEON_AUTH_URL's JWKS. `local` skips the
# login: every request is the fixed user "local-dev", which is an admin only
# when listed in ADMIN_USER_IDS.
AUTH_MODE=local
# Neon Console > Auth > Configuration, e.g.
# https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth (neon mode only).
NEON_AUTH_URL=
# Shared secret of server-to-server calls (the worker's evaluation trigger and
# the scheduled maintenance); required in neon mode. Empty rejects them all.
# Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=
# Comma-separated user ids (the JWT `sub`) with unlimited interviews and access
# to /api/runtime. The token's own `role` claim never grants anything.
ADMIN_USER_IDS=local-dev
# Interviews any other account can ever start (deleting them gives none back),
# and all of them together per calendar month (UTC).
LIFETIME_INTERVIEWS_PER_USER=3
GUEST_INTERVIEWS_PER_MONTH=2
# Comma-separated browser origins allowed to call the API from another origin
# (e.g. https://app.example.com). Empty: same-origin only, no CORS headers.
CORS_ALLOWED_ORIGINS=

# --- STT (AssemblyAI via LiveKit Inference) ---
# The transcription language, the TTS voice and the agent's name/persona are
# NOT env vars: they are configured in the app's Settings screen (the voice
# catalog lives in interview_agent/voices.py).
STT_MODEL=assemblyai/universal-3-6-pro

# --- Interview system ---
# Planner/evaluator run once per interview with no latency pressure:
# quality-first model + high reasoning effort.
PLANNER_MODEL=gpt-6-astra
PLANNER_REASONING_EFFORT=high
EVALUATOR_MODEL=gpt-6-astra
EVALUATOR_REASONING_EFFORT=high
# Postgres from docker-compose.yml (host port, used in local dev
# mode; the full-Docker stack overrides these with the service names).
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview

# Global ceiling on the voice interview's time cap. Each interview gets its
# own cap from the length picked on the form (short 8 / standard 15 / deep
# 25 minutes), clamped to this value: wrap-up cue at T-2min, forced close at
# T. Milestones normally end it earlier. 25 lets every shipped length run to
# its planned length; lowering it makes the planner plan for the clamped time.
INTERVIEW_MAX_MINUTES=25
# Soft cap on simultaneous interviews (cost protection): /token returns 429
# once this many are in progress.
MAX_CONCURRENT_INTERVIEWS=3
# End the interview if the conversation stays silent this long (no speech
# from either side), e.g. the candidate walked away with the tab open.
INTERVIEW_IDLE_MINUTES=3
# Reconnect grace, included in the original wall-clock interview duration.
INTERVIEW_RECONNECT_SECONDS=10
# Explicit-dispatch agent name; must match the RoomAgentDispatch in the token.
LIVEKIT_AGENT_NAME=interviewer
# Where the worker reaches FastAPI to auto-trigger the evaluation.
APP_BASE_URL=http://localhost:8000
# PII retention: interviews (resume, transcript, evaluation) older than this
# are purged from Postgres by the server. 0 disables the purge.
RETENTION_DAYS=30

# Process startup manifests are kept this many days. Metrics are not kept in
# Postgres; they leave through OTLP (below).
METRICS_DETAIL_DAYS=30
CLOSING_TIMEOUT_SECONDS=20
# Optional. Setting the key is consent to send each interview's full content to
# LangSmith (CV, offer, plan, turns, prompts, answers, evaluation and session
# audio). It then follows the LangSmith project's retention (base 14 days,
# extended 400; anything added to a dataset can live longer) and the app
# never deletes it. Empty: nothing is sent.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Graceful worker shutdown: running interviews may finish within this window.
WORKER_DRAIN_MINUTES=30

# --- Metrics (optional) — anonymous, over OTLP/HTTP ---
# Categories and numbers only: no interview content and no interview, trace
# or turn IDs. In uv dev mode, the compose `lgtm` service (Grafana on
# http://localhost:3001) receives them here; the full-Docker stack overrides
# this with http://lgtm:4318. Empty: no metrics are exported.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Empty locally. Grafana Cloud: Authorization=Basic%20<base64(instanceId:token)>
# (comma-separated key=value pairs, URL-encoded values).
OTEL_EXPORTER_OTLP_HEADERS=

# --- Error reporting (optional) — Sentry ---
# Exception types, stack frames and reviewed log templates only: no interview
# content, exception messages, request bodies, headers or local variables; the
# user is the opaque account id. Empty: nothing is reported.
SENTRY_DSN=
# Production sets SENTRY_ENVIRONMENT=production.
SENTRY_ENVIRONMENT=development

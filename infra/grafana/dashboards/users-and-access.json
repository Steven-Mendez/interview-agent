    {
      "type": "stat",
      "title": "Users by role",
      "description": "Users with a profile (everyone who opened the app signed in), admins being those listed in ADMIN_USER_IDS. The API recounts it from the database every minute; with several API instances, the most recent report in the range is shown, so an instance that has since stopped never outweighs a newer count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (role) (last_over_time(interview_agent_accounts_users[$__range]) and (last_over_time(timestamp(interview_agent_accounts_users)[$__range:]) == on (role) group_left max by (role) (last_over_time(timestamp(interview_agent_accounts_users)[$__range:]))))",
          "legendFormat": "{{role}}",
          "refId": "A",
          "instant": true,
          "range": false

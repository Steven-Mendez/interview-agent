# Browser error reports to Sentry, without interview content (see
# src/lib/error-reporting.ts). Read at build time; empty: nothing is reported.
VITE_SENTRY_DSN=

# Sign-in with Neon Auth (see src/lib/auth.ts): the project's Auth URL, e.g.
# https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth. Empty: for
# an API running with AUTH_MODE=local, which the app asks at runtime
# (GET /api/auth/config) — no sign-in, or the dev login of LOCAL_ACCOUNTS.
# VITE_NEON_AUTH_URL=

# The API when it is served from another origin, ending in /api (see
# src/lib/api-base.ts). Empty: "/api" on this origin (the dev proxy).
# VITE_API_BASE_URL=
